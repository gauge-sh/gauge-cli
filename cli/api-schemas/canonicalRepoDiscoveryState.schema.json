{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical repository discovery checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "technology", "target", "queries", "maxLoops", "loopsStarted",
    "next", "pending", "checkedNames", "stage", "frozenUrls", "counts", "groupRevision",
    "approvalRevision", "published"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "format": "uuid" },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "scope"],
      "properties": {
        "name": { "type": "string", "pattern": "\\S" },
        "url": { "type": "string", "format": "uri" },
        "scope": { "type": "string", "pattern": "\\S" }
      }
    },
    "target": { "$ref": "#/$defs/positive" },
    "queries": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "maxLoops": { "$ref": "#/$defs/positive" },
    "loopsStarted": { "$ref": "#/$defs/count" },
    "next": {
      "description": "First unfinished query and page, or null if all query windows are exhausted.",
      "anyOf": [{ "$ref": "#/$defs/pageCursor" }, { "type": "null" }]
    },
    "pending": {
      "description": "The active page. During enrich, names.json contains this page's filtered input.",
      "anyOf": [{ "$ref": "#/$defs/search" }, { "$ref": "#/$defs/enrich" }, { "type": "null" }]
    },
    "checkedNames": {
      "description": "Lowercase owner/repository names from completed pages, including ineligible repositories.",
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9_.-]+$" }
    },
    "stage": {
      "enum": ["collecting", "frozen", "summarizing", "grouping", "awaiting-group-approval", "publishing", "complete"]
    },
    "frozenUrls": {
      "description": "Unique eligible repository URLs in discovery order. Empty until frozen.",
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repoUrl" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uniqueEligible", "checked"],
      "properties": {
        "uniqueEligible": { "$ref": "#/$defs/count" },
        "checked": { "$ref": "#/$defs/count" }
      }
    },
    "groupRevision": { "$ref": "#/$defs/revision" },
    "approvalRevision": { "$ref": "#/$defs/revision" },
    "published": {
      "description": "Group names mapped to the GitHub URLs returned by successful flushes.",
      "type": "object", "additionalProperties": { "$ref": "#/$defs/repoUrl" }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "positive": { "type": "integer", "minimum": 1 },
    "revision": { "anyOf": [{ "$ref": "#/$defs/positive" }, { "type": "null" }] },
    "repoUrl": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$" },
    "queryIndex": { "description": "Zero-based index in queries.", "$ref": "#/$defs/count" },
    "pageNumber": { "type": "integer", "minimum": 1, "maximum": 10 },
    "pageCursor": {
      "type": "object", "additionalProperties": false, "required": ["query", "page"],
      "properties": { "query": { "$ref": "#/$defs/queryIndex" }, "page": { "$ref": "#/$defs/pageNumber" } }
    },
    "search": {
      "type": "object", "additionalProperties": false, "required": ["query", "page", "phase"],
      "properties": {
        "query": { "$ref": "#/$defs/queryIndex" }, "page": { "$ref": "#/$defs/pageNumber" }, "phase": { "const": "search" }
      }
    },
    "enrich": {
      "type": "object", "additionalProperties": false, "required": ["query", "page", "phase", "rawCount"],
      "properties": {
        "query": { "$ref": "#/$defs/queryIndex" }, "page": { "$ref": "#/$defs/pageNumber" },
        "phase": { "const": "enrich" }, "rawCount": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
