{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@withgauge/api-schemas": ["./api-schemas"],
      "@withgauge/api-schemas/*": ["./api-schemas/*"],
      "@withgauge/local-execution": ["../packages/local/dist/index"],
      "zod": ["./node_modules/zod"],
      "yaml": ["./node_modules/yaml"],
      "minimatch": ["./node_modules/minimatch"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tsup.config.ts",
    "./api-schemas/**/*.ts"
  ]
}
